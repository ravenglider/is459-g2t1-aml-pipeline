{
  "Comment": "IS459 G2T1 AML pipeline: ingest external rates, crawl, ETL, BQ1 and BQ2 in parallel. Pass states are placeholders until teammates' jobs exist.",
  "StartAt": "FetchRates",
  "States": {
    "FetchRates": {
      "Type": "Task",
      "Comment": "Role 1: Lambda pulls ECB FX and Coinbase BTC into s3://is459-g2t1-aml-bucket/fx and /btc",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "is459-g2t1-fetch-fxbtc-rates",
        "Payload": {}
      },
      "ResultSelector": {
        "rates.$": "$.Payload"
      },
      "ResultPath": "$.fetch",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.TooManyRequestsException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "StartRatesCrawler"
    },
    "StartRatesCrawler": {
      "Type": "Task",
      "Comment": "Role 1: refresh raw_fx and raw_btc tables",
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "Parameters": {
        "Name": "is459-g2t1-fxbtc-rates-crawler"
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "Glue.CrawlerRunningException"
          ],
          "ResultPath": null,
          "Next": "WaitForRatesCrawler"
        }
      ],
      "Next": "WaitForRatesCrawler"
    },
    "WaitForRatesCrawler": {
      "Type": "Wait",
      "Seconds": 20,
      "Next": "GetRatesCrawlerState"
    },
    "GetRatesCrawlerState": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:getCrawler",
      "Parameters": {
        "Name": "is459-g2t1-fxbtc-rates-crawler"
      },
      "ResultSelector": {
        "state.$": "$.Crawler.State"
      },
      "ResultPath": "$.ratesCrawler",
      "Next": "RatesCrawlerDone?"
    },
    "RatesCrawlerDone?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.ratesCrawler.state",
          "StringEquals": "READY",
          "Next": "ETL_TransactionsClean"
        }
      ],
      "Default": "WaitForRatesCrawler"
    },
    "ETL_TransactionsClean": {
      "Type": "Task",
      "Comment": "Role 2: Glue job builds transactions_clean (Parquet) and updates the catalog. Fails on purpose if data quality checks fail.",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "is459-g2t1-etl-transactions-clean",
        "Arguments": {
          "--DATASET": "HI-Medium"
        }
      },
      "TimeoutSeconds": 3600,
      "ResultPath": "$.etl",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.etlError",
          "Next": "ETLFailed"
        }
      ],
      "Next": "Analytics"
    },
    "Analytics": {
      "Type": "Parallel",
      "Comment": "BQ1 corridors, BQ1 graph (Role 4) and BQ2 run in parallel once transactions_clean exists",
      "ResultPath": "$.analytics",
      "Branches": [
        {
          "StartAt": "BQ1_ResetOutputs",
          "States": {
            "BQ1_ResetOutputs": {
              "Type": "Task",
              "Comment": "Role 1 helper: drop the 4 BQ1 tables and empty their S3 folders so CTAS can rerun",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "is459-g2t1-reset-outputs",
                "Payload": {
                  "bucket": "is459-g2t1-aml-processed-bucket",
                  "database": "is459_g2t1_aml",
                  "outputs": [
                    {
                      "table": "bq1_direct_corridors",
                      "prefix": "bq1_direct_corridors/"
                    },
                    {
                      "table": "bq1_attempt_banks",
                      "prefix": "bq1_attempt_banks/"
                    },
                    {
                      "table": "bq1_shared_attempt_value",
                      "prefix": "bq1_shared_attempt_value/"
                    },
                    {
                      "table": "bq1_corridors_ranked",
                      "prefix": "bq1_corridors_ranked/"
                    }
                  ]
                }
              },
              "ResultPath": null,
              "Next": "BQ1_Step1_and_2a"
            },
            "BQ1_Step1_and_2a": {
              "Type": "Parallel",
              "Comment": "Role 3: steps 1 and 2a are independent, run together",
              "ResultPath": null,
              "Branches": [
                {
                  "StartAt": "BQ1_DirectCorridors",
                  "States": {
                    "BQ1_DirectCorridors": {
                      "Type": "Task",
                      "Comment": "Role 3 step 1: direct cross-bank corridor totals",
                      "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
                      "Parameters": {
                        "QueryString": "CREATE TABLE is459_g2t1_aml.bq1_direct_corridors\nWITH (\n  format = 'PARQUET',\n  external_location = 's3://is459-g2t1-aml-processed-bucket/bq1_direct_corridors/'\n) AS\nSELECT\n  from_bank,\n  to_bank,\n  SUM(CASE WHEN is_laundering = 1 THEN amount_paid_usd ELSE 0 END) AS direct_laundered_usd,\n  SUM(amount_paid_usd) AS direct_total_usd,\n  COUNT(CASE WHEN is_laundering = 1 THEN 1 END) AS direct_laundering_txns,\n  COUNT(*) AS direct_total_txns\nFROM is459_g2t1_aml.transactions_clean\nWHERE dataset = 'HI-Medium'\n  AND cross_bank = 1\n  AND amount_paid_usd < 20000000\nGROUP BY from_bank, to_bank",
                        "WorkGroup": "primary",
                        "QueryExecutionContext": {
                          "Database": "is459_g2t1_aml"
                        },
                        "ResultConfiguration": {
                          "OutputLocation": "s3://is459-g2t1-aml-athena-bucket/results/"
                        }
                      },
                      "ResultPath": null,
                      "End": true
                    }
                  }
                },
                {
                  "StartAt": "BQ1_AttemptBanks",
                  "States": {
                    "BQ1_AttemptBanks": {
                      "Type": "Task",
                      "Comment": "Role 3 step 2a: per-attempt totals and banks touched",
                      "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
                      "Parameters": {
                        "QueryString": "CREATE TABLE is459_g2t1_aml.bq1_attempt_banks\nWITH (\n  format = 'PARQUET',\n  external_location = 's3://is459-g2t1-aml-processed-bucket/bq1_attempt_banks/'\n) AS\nSELECT\n  attempt_id,\n  SUM(amount_paid_usd) AS attempt_total_usd,\n  ARRAY_DISTINCT(ARRAY_AGG(DISTINCT from_bank) || ARRAY_AGG(DISTINCT to_bank)) AS banks_touched\nFROM is459_g2t1_aml.transactions_clean\nWHERE dataset = 'HI-Medium'\n  AND is_laundering = 1\n  AND attempt_id IS NOT NULL\n  AND amount_paid_usd < 20000000\nGROUP BY attempt_id",
                        "WorkGroup": "primary",
                        "QueryExecutionContext": {
                          "Database": "is459_g2t1_aml"
                        },
                        "ResultConfiguration": {
                          "OutputLocation": "s3://is459-g2t1-aml-athena-bucket/results/"
                        }
                      },
                      "ResultPath": null,
                      "End": true
                    }
                  }
                }
              ],
              "Next": "BQ1_SharedAttemptValue"
            },
            "BQ1_SharedAttemptValue": {
              "Type": "Task",
              "Comment": "Role 3 step 2b: shared attempt value per bank pair",
              "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
              "Parameters": {
                "QueryString": "CREATE TABLE is459_g2t1_aml.bq1_shared_attempt_value\nWITH (\n  format = 'PARQUET',\n  external_location = 's3://is459-g2t1-aml-processed-bucket/bq1_shared_attempt_value/'\n) AS\nSELECT\n  a.bank_x AS from_bank,\n  b.bank_y AS to_bank,\n  SUM(t.attempt_total_usd) AS shared_attempt_value_usd\nFROM is459_g2t1_aml.bq1_attempt_banks t\nCROSS JOIN UNNEST(t.banks_touched) AS a(bank_x)\nCROSS JOIN UNNEST(t.banks_touched) AS b(bank_y)\nWHERE a.bank_x != b.bank_y\nGROUP BY a.bank_x, b.bank_y",
                "WorkGroup": "primary",
                "QueryExecutionContext": {
                  "Database": "is459_g2t1_aml"
                },
                "ResultConfiguration": {
                  "OutputLocation": "s3://is459-g2t1-aml-athena-bucket/results/"
                }
              },
              "ResultPath": null,
              "Next": "BQ1_CorridorsRanked"
            },
            "BQ1_CorridorsRanked": {
              "Type": "Task",
              "Comment": "Role 3 step 3: final ranked corridors (extra laundering value, blindspot gap)",
              "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
              "Parameters": {
                "QueryString": "CREATE TABLE is459_g2t1_aml.bq1_corridors_ranked\nWITH (\n  format = 'PARQUET',\n  external_location = 's3://is459-g2t1-aml-processed-bucket/bq1_corridors_ranked/'\n) AS\nSELECT\n  d.from_bank,\n  d.to_bank,\n  d.direct_laundered_usd,\n  COALESCE(s.shared_attempt_value_usd, 0) AS total_laundering_in_path_usd,\n  GREATEST(COALESCE(s.shared_attempt_value_usd, 0) - d.direct_laundered_usd, 0) AS extra_laundering_value_usd,\n  CASE WHEN COALESCE(s.shared_attempt_value_usd, 0) > 0\n    THEN GREATEST(COALESCE(s.shared_attempt_value_usd, 0) - d.direct_laundered_usd, 0)\n         / CAST(s.shared_attempt_value_usd AS DOUBLE)\n    ELSE 0 END AS blindspot_gap\nFROM is459_g2t1_aml.bq1_direct_corridors d\nLEFT JOIN is459_g2t1_aml.bq1_shared_attempt_value s\n  ON d.from_bank = s.from_bank AND d.to_bank = s.to_bank",
                "WorkGroup": "primary",
                "QueryExecutionContext": {
                  "Database": "is459_g2t1_aml"
                },
                "ResultConfiguration": {
                  "OutputLocation": "s3://is459-g2t1-aml-athena-bucket/results/"
                }
              },
              "ResultPath": null,
              "End": true
            }
          }
        },
        {
          "StartAt": "Graph_Init",
          "States": {
            "Graph_Init": {
              "Type": "Pass",
              "Comment": "Role 4: fresh run ID per execution (runner rejects reused IDs)",
              "Parameters": {
                "runId.$": "States.Format('sf-{}', States.UUID())",
                "dataset": "HI-Medium",
                "startedByPipeline": false
              },
              "ResultPath": "$.graph",
              "Next": "Graph_CheckInstance"
            },
            "Graph_CheckInstance": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
              "Parameters": {
                "InstanceIds": [
                  "i-0125056b848e5634a"
                ]
              },
              "ResultSelector": {
                "state.$": "$.Reservations[0].Instances[0].State.Name"
              },
              "ResultPath": "$.graph.instance",
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "ResultPath": "$.graph.error",
                  "Next": "Graph_CleanupOnFailure"
                }
              ],
              "Next": "Graph_InstanceState?"
            },
            "Graph_InstanceState?": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.graph.instance.state",
                  "StringEquals": "running",
                  "Next": "Graph_CheckSsmOnline"
                },
                {
                  "Variable": "$.graph.instance.state",
                  "StringEquals": "stopped",
                  "Next": "Graph_StartInstance"
                },
                {
                  "Or": [
                    {
                      "Variable": "$.graph.instance.state",
                      "StringEquals": "pending"
                    },
                    {
                      "Variable": "$.graph.instance.state",
                      "StringEquals": "stopping"
                    }
                  ],
                  "Next": "Graph_WaitInstance"
                }
              ],
              "Default": "Graph_CleanupOnFailure"
            },
            "Graph_StartInstance": {
              "Type": "Task",
              "Comment": "Only starts the instance if it was stopped; remembers this so it is stopped again afterwards",
              "Resource": "arn:aws:states:::aws-sdk:ec2:startInstances",
              "Parameters": {
                "InstanceIds": [
                  "i-0125056b848e5634a"
                ]
              },
              "ResultPath": null,
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "ResultPath": "$.graph.error",
                  "Next": "Graph_CleanupOnFailure"
                }
              ],
              "Next": "Graph_MarkStarted"
            },
            "Graph_MarkStarted": {
              "Type": "Pass",
              "Result": true,
              "ResultPath": "$.graph.startedByPipeline",
              "Next": "Graph_WaitInstance"
            },
            "Graph_WaitInstance": {
              "Type": "Wait",
              "Seconds": 20,
              "Next": "Graph_CheckInstance"
            },
            "Graph_CheckSsmOnline": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:ssm:describeInstanceInformation",
              "Parameters": {
                "Filters": [
                  {
                    "Key": "InstanceIds",
                    "Values": [
                      "i-0125056b848e5634a"
                    ]
                  }
                ]
              },
              "ResultSelector": {
                "pings.$": "$.InstanceInformationList[*].PingStatus"
              },
              "ResultPath": "$.graph.ssm",
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "ResultPath": "$.graph.error",
                  "Next": "Graph_CleanupOnFailure"
                }
              ],
              "Next": "Graph_SsmOnlineFlag"
            },
            "Graph_SsmOnlineFlag": {
              "Type": "Pass",
              "Parameters": {
                "online.$": "States.ArrayContains($.graph.ssm.pings, 'Online')"
              },
              "ResultPath": "$.graph.ssmOnline",
              "Next": "Graph_SsmOnline?"
            },
            "Graph_SsmOnline?": {
              "Type": "Choice",
              "Choices": [
                {
                  "And": [
                    {
                      "Variable": "$.graph.ssmOnline.online",
                      "BooleanEquals": true
                    },
                    {
                      "Variable": "$.graph.startedByPipeline",
                      "BooleanEquals": true
                    }
                  ],
                  "Next": "Graph_WaitForNeo4j"
                },
                {
                  "Variable": "$.graph.ssmOnline.online",
                  "BooleanEquals": true,
                  "Next": "Graph_RunGraph"
                }
              ],
              "Default": "Graph_WaitSsm"
            },
            "Graph_WaitSsm": {
              "Type": "Wait",
              "Seconds": 15,
              "Next": "Graph_CheckSsmOnline"
            },
            "Graph_WaitForNeo4j": {
              "Type": "Wait",
              "Comment": "Fresh boot: give Docker/Neo4j time to start before the runner connects",
              "Seconds": 90,
              "Next": "Graph_RunGraph"
            },
            "Graph_RunGraph": {
              "Type": "Task",
              "Comment": "Role 4: run the graph runner via her SSM document",
              "Resource": "arn:aws:states:::aws-sdk:ssm:sendCommand",
              "Parameters": {
                "DocumentName": "is459-g2t1-role4-graph",
                "DocumentVersion": "1",
                "InstanceIds": [
                  "i-0125056b848e5634a"
                ],
                "Parameters": {
                  "runId.$": "States.Array($.graph.runId)",
                  "dataset.$": "States.Array($.graph.dataset)"
                },
                "TimeoutSeconds": 600,
                "Comment": "IS459 G2T1 pipeline graph run"
              },
              "ResultSelector": {
                "commandId.$": "$.Command.CommandId"
              },
              "ResultPath": "$.graph.command",
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "ResultPath": "$.graph.error",
                  "Next": "Graph_CleanupOnFailure"
                }
              ],
              "Next": "Graph_WaitCommand"
            },
            "Graph_WaitCommand": {
              "Type": "Wait",
              "Seconds": 15,
              "Next": "Graph_GetCommandStatus"
            },
            "Graph_GetCommandStatus": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:ssm:getCommandInvocation",
              "Parameters": {
                "CommandId.$": "$.graph.command.commandId",
                "InstanceId": "i-0125056b848e5634a"
              },
              "ResultSelector": {
                "status.$": "$.Status",
                "responseCode.$": "$.ResponseCode"
              },
              "ResultPath": "$.graph.commandResult",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Ssm.InvocationDoesNotExistException"
                  ],
                  "IntervalSeconds": 5,
                  "MaxAttempts": 6,
                  "BackoffRate": 1.5
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "ResultPath": "$.graph.error",
                  "Next": "Graph_CleanupOnFailure"
                }
              ],
              "Next": "Graph_CommandDone?"
            },
            "Graph_CommandDone?": {
              "Type": "Choice",
              "Choices": [
                {
                  "And": [
                    {
                      "Variable": "$.graph.commandResult.status",
                      "StringEquals": "Success"
                    },
                    {
                      "Variable": "$.graph.commandResult.responseCode",
                      "NumericEquals": 0
                    }
                  ],
                  "Next": "Graph_ReadReceipt"
                },
                {
                  "Or": [
                    {
                      "Variable": "$.graph.commandResult.status",
                      "StringEquals": "Success"
                    },
                    {
                      "Variable": "$.graph.commandResult.status",
                      "StringEquals": "Failed"
                    },
                    {
                      "Variable": "$.graph.commandResult.status",
                      "StringEquals": "Cancelled"
                    },
                    {
                      "Variable": "$.graph.commandResult.status",
                      "StringEquals": "TimedOut"
                    }
                  ],
                  "Next": "Graph_CleanupOnFailure"
                }
              ],
              "Default": "Graph_WaitCommand"
            },
            "Graph_ReadReceipt": {
              "Type": "Task",
              "Comment": "Validate the run-specific success.json the runner publishes last",
              "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
              "Parameters": {
                "Bucket": "is459-g2t1-aml-processed-bucket",
                "Key.$": "States.Format('bq1_graph_results/{}/success.json', $.graph.runId)"
              },
              "ResultSelector": {
                "receipt.$": "States.StringToJson($.Body)"
              },
              "ResultPath": "$.graph.receipt",
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "ResultPath": "$.graph.error",
                  "Next": "Graph_CleanupOnFailure"
                }
              ],
              "Next": "Graph_ReceiptValid?"
            },
            "Graph_ReceiptValid?": {
              "Type": "Choice",
              "Choices": [
                {
                  "And": [
                    {
                      "Variable": "$.graph.receipt.receipt.status",
                      "StringEquals": "SUCCEEDED"
                    },
                    {
                      "Variable": "$.graph.receipt.receipt.run_id",
                      "StringEqualsPath": "$.graph.runId"
                    },
                    {
                      "Variable": "$.graph.receipt.receipt.dataset",
                      "StringEqualsPath": "$.graph.dataset"
                    },
                    {
                      "Variable": "$.graph.receipt.receipt.feature_table",
                      "IsPresent": true
                    }
                  ],
                  "Next": "Graph_UpdateLatestView"
                }
              ],
              "Default": "Graph_CleanupOnFailure"
            },
            "Graph_UpdateLatestView": {
              "Type": "Task",
              "Comment": "Stable name for Role 3 / Tableau: points at this run's validated feature table",
              "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
              "Parameters": {
                "QueryString.$": "States.Format('CREATE OR REPLACE VIEW is459_g2t1_aml.bq1_graph_bank_features_latest AS SELECT * FROM {}', $.graph.receipt.receipt.feature_table)",
                "WorkGroup": "primary",
                "QueryExecutionContext": {
                  "Database": "is459_g2t1_aml"
                },
                "ResultConfiguration": {
                  "OutputLocation": "s3://is459-g2t1-aml-athena-bucket/results/"
                }
              },
              "ResultPath": null,
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "ResultPath": "$.graph.error",
                  "Next": "Graph_CleanupOnFailure"
                }
              ],
              "Next": "Graph_StopIfStarted?"
            },
            "Graph_StopIfStarted?": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.graph.startedByPipeline",
                  "BooleanEquals": true,
                  "Next": "Graph_StopInstance"
                }
              ],
              "Default": "Graph_Done"
            },
            "Graph_StopInstance": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:ec2:stopInstances",
              "Parameters": {
                "InstanceIds": [
                  "i-0125056b848e5634a"
                ]
              },
              "ResultPath": null,
              "Next": "Graph_Done"
            },
            "Graph_Done": {
              "Type": "Succeed"
            },
            "Graph_CleanupOnFailure": {
              "Type": "Choice",
              "Comment": "On any failure: stop the instance only if this run started it",
              "Choices": [
                {
                  "Variable": "$.graph.startedByPipeline",
                  "BooleanEquals": true,
                  "Next": "Graph_StopOnFailure"
                }
              ],
              "Default": "Graph_Failed"
            },
            "Graph_StopOnFailure": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:ec2:stopInstances",
              "Parameters": {
                "InstanceIds": [
                  "i-0125056b848e5634a"
                ]
              },
              "ResultPath": null,
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "ResultPath": null,
                  "Next": "Graph_Failed"
                }
              ],
              "Next": "Graph_Failed"
            },
            "Graph_Failed": {
              "Type": "Fail",
              "Error": "Role4GraphFailed",
              "Cause": "Role 4 graph run failed: see the failed step, SSM command output, or bq1_graph_results/<runId>/ in S3"
            }
          }
        },
        {
          "StartAt": "BQ2_SequenceBuilder",
          "States": {
            "BQ2_SequenceBuilder": {
              "Type": "Pass",
              "Comment": "Role 5 PLACEHOLDER. Replace with glue:startJobRun.sync building bq2_sequences",
              "Result": "placeholder: bq2_sequences",
              "Next": "BQ2_LiftAnalysis"
            },
            "BQ2_LiftAnalysis": {
              "Type": "Pass",
              "Comment": "Role 6 PLACEHOLDER. Replace with athena:startQueryExecution.sync building bq2_lift",
              "Result": "placeholder: bq2_lift",
              "End": true
            }
          }
        }
      ],
      "Next": "BQ1_PriorityReset"
    },
    "BQ1_PriorityReset": {
      "Type": "Task",
      "Comment": "Role 1 helper: drop bq1_priority_sharing_list and empty its folder so the CTAS can rerun",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "is459-g2t1-reset-outputs",
        "Payload": {
          "bucket": "is459-g2t1-aml-processed-bucket",
          "database": "is459_g2t1_aml",
          "outputs": [
            {
              "table": "bq1_priority_sharing_list",
              "prefix": "bq1_priority_sharing_list/"
            }
          ]
        }
      },
      "ResultPath": null,
      "Next": "BQ1_PriorityList"
    },
    "BQ1_PriorityList": {
      "Type": "Task",
      "Comment": "Role 3: final priority sharing list = ranked corridors + Role 4 graph features (_latest view)",
      "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
      "Parameters": {
